{
  "name": "cube-oss",
  "displayName": "精弘立方存储",
  "description": "Manage your Cube OSS in your code.",
  "version": "0.3.0",
  "publisher": "Shy",
  "repository": {
    "type": "git",
    "url": "https://github.com/1208nn/cube-code.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cube OSS",
      "properties": {
        "cube-oss.apiUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Cube OSS 后端地址。"
        },
        "cube-oss.downloadDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "默认下载目录。"
        },
        "cube-oss.webpConvertible": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".jpg",
            ".jpeg",
            ".png",
            ".gif",
            ".tif",
            ".tiff",
            ".bmp"
          ],
          "markdownDescription": "开启 WebP 转换时，仅这些扩展名的图片会被转换。"
        },
        "cube-oss.convertWebp": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "开启后，上传时白名单内的图片会转换为 WebP。"
        },
        "cube-oss.useUuid": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "开启后，上传文件会使用 UUID 重命名。"
        }
      }
    },
    "keybindings": [
      {
        "key": "delete",
        "command": "cube.deleteFile",
        "when": "focusedView == 'cubeExplorer'"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cube",
          "title": "Cube OSS",
          "icon": "media/cube.svg"
        }
      ]
    },
    "views": {
      "cube": [
        {
          "id": "cubeExplorer",
          "icon": "media/cube.svg",
          "name": "资源管理器",
          "contextualTitle": "Cube OSS"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cubeExplorer",
        "contents": "连接你的 Cube OSS 后端。\n[设置 API 地址](command:cube.setApiUrl)\n[设置 API Key](command:cube.setApiKey)",
        "when": "!cube-oss.hasApiKey"
      }
    ],
    "commands": [
      {
        "command": "cube.setApiKey",
        "title": "设置 API Key",
        "category": "Cube"
      },
      {
        "command": "cube.setApiUrl",
        "title": "设置 API 地址",
        "category": "Cube"
      },
      {
        "command": "cube.clearApiKey",
        "title": "清除 API Key",
        "category": "Cube"
      },
      {
        "command": "cube.refresh",
        "title": "刷新",
        "category": "Cube",
        "icon": "$(refresh)"
      },
      {
        "command": "cube.setFilenameKeep",
        "title": "保留文件名",
        "category": "Cube"
      },
      {
        "command": "cube.setFilenameRandom",
        "title": "开启随机文件名",
        "category": "Cube"
      },
      {
        "command": "cube.setFormatWebp",
        "title": "转换为 WebP",
        "category": "Cube"
      },
      {
        "command": "cube.setFormatKeep",
        "title": "保留原格式",
        "category": "Cube"
      },
      {
        "command": "cube.openSettings",
        "title": "更多设置...",
        "category": "Cube"
      },
      {
        "command": "cube.uploadFile",
        "title": "上传文件...",
        "category": "Cube",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "cube.newFolder",
        "title": "新建文件夹...",
        "category": "Cube",
        "icon": "$(new-folder)"
      },
      {
        "command": "cube.downloadFile",
        "title": "下载",
        "category": "Cube",
        "icon": "$(cloud-download)"
      },
      {
        "command": "cube.deleteFile",
        "title": "删除",
        "category": "Cube",
        "icon": "$(trash)"
      },
      {
        "command": "cube.copyFileUrl",
        "title": "复制文件地址",
        "category": "Cube",
        "icon": "$(link)"
      },
      {
        "command": "cube.openFile",
        "title": "打开文件",
        "category": "Cube"
      },
      {
        "command": "cube.previewImage",
        "title": "预览图片",
        "category": "Cube",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cube.refresh",
          "when": "view == cubeExplorer",
          "group": "navigation"
        },
        {
          "command": "cube.uploadFile",
          "when": "view == cubeExplorer",
          "group": "navigation"
        },
        {
          "command": "cube.newFolder",
          "when": "view == cubeExplorer",
          "group": "navigation"
        },
        {
          "command": "cube.setFilenameKeep",
          "when": "view == cubeExplorer && cube-oss.useUuid",
          "group": "2_options@1",
          "title": "保留文件名"
        },
        {
          "command": "cube.setFilenameRandom",
          "when": "view == cubeExplorer && !cube-oss.useUuid",
          "group": "2_options@1",
          "title": "开启随机文件名"
        },
        {
          "command": "cube.setFormatWebp",
          "when": "view == cubeExplorer && !cube-oss.convertWebp",
          "group": "2_options@2",
          "title": "转换为 WebP"
        },
        {
          "command": "cube.setFormatKeep",
          "when": "view == cubeExplorer && cube-oss.convertWebp",
          "group": "2_options@2",
          "title": "保留原格式"
        },
        {
          "command": "cube.setApiKey",
          "when": "view == cubeExplorer",
          "group": "8_settings"
        },
        {
          "command": "cube.setApiUrl",
          "when": "view == cubeExplorer",
          "group": "8_settings"
        },
        {
          "command": "cube.openSettings",
          "when": "view == cubeExplorer",
          "group": "9_more",
          "title": "更多设置..."
        }
      ],
      "view/item/context": [
        {
          "command": "cube.uploadFile",
          "when": "view == cubeExplorer && viewItem =~ /^(bucket|folder)$/",
          "group": "1_modification"
        },
        {
          "command": "cube.newFolder",
          "when": "view == cubeExplorer && viewItem =~ /^(bucket|folder)$/",
          "group": "1_modification"
        },
        {
          "command": "cube.previewImage",
          "when": "view == cubeExplorer && viewItem == image",
          "group": "inline"
        },
        {
          "command": "cube.downloadFile",
          "when": "view == cubeExplorer && viewItem =~ /^(file|image)$/",
          "group": "2_action"
        },
        {
          "command": "cube.copyFileUrl",
          "when": "view == cubeExplorer && viewItem =~ /^(file|image)$/",
          "group": "2_action"
        },
        {
          "command": "cube.deleteFile",
          "when": "view == cubeExplorer && viewItem =~ /^(file|image)$/",
          "group": "3_delete"
        }
      ]
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest": "pnpm run compile-web",
    "vscode:prepublish": "pnpm run package-web",
    "compile-web": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/assert": "^1.5.11",
    "@types/mocha": "^10.0.10",
    "@types/vscode": "^1.125.0",
    "@vscode/test-web": "^0.0.81",
    "assert": "^2.1.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "glob": "^13.0.6",
    "mocha": "^11.7.6",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
