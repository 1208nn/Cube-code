{
  "name": "cube",
  "displayName": "Cube",
  "description": "Manage your Cube OSS",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "browser": "./dist/web/extension.js",
  "contributes": {
    "configuration": {
      "title": "Cube OSS",
      "properties": {
        "cube.apiUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Cube OSS 后端地址（例如 `https://oss.example.com/`）。`/api`、`/files`、`/thumbnails` 端点都基于此地址解析。"
        },
        "cube.downloadDirectory": {
          "type": "string",
          "default": "",
          "markdownDescription": "下载默认目录（绝对路径，例如 `C:/Users/you/Downloads`）。留空 = 第一个已打开的工作区文件夹，再退化为系统默认。"
        },
        "cube.webpConvertible": {
          "type": "array",
          "items": { "type": "string" },
          "default": [".jpg", ".jpeg", ".png", ".gif", ".tif", ".tiff", ".bmp"],
          "markdownDescription": "开启 WebP 转换时，仅这些扩展名的图片会被转换。可在此声明式增删支持的格式（例如新增 `.webp`）。"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cube",
          "title": "Cube OSS",
          "icon": "media/cube.svg"
        }
      ]
    },
    "views": {
      "cube": [
        {
          "id": "cubeExplorer",
          "name": "资源管理器",
          "contextualTitle": "Cube OSS"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "cubeExplorer",
        "contents": "连接你的 Cube OSS 后端。\n[设置 API 地址](command:cube.setApiUrl)\n[设置 API Key](command:cube.setApiKey)",
        "when": "!cube.hasApiKey"
      }
    ],
    "commands": [
      {
        "command": "cube.setApiKey",
        "title": "设置 API Key",
        "category": "Cube"
      },
      {
        "command": "cube.setApiUrl",
        "title": "设置 API 地址",
        "category": "Cube"
      },
      {
        "command": "cube.clearApiKey",
        "title": "清除 API Key",
        "category": "Cube"
      },
      {
        "command": "cube.refresh",
        "title": "刷新",
        "category": "Cube",
        "icon": "$(refresh)"
      },
      {
        "command": "cube.toggleConvertWebp",
        "title": "WebP 转换开关",
        "category": "Cube"
      },
      {
        "command": "cube.toggleUseUuid",
        "title": "UUID 重命名开关",
        "category": "Cube"
      },
      {
        "command": "cube.uploadFile",
        "title": "上传文件...",
        "category": "Cube",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "cube.newFolder",
        "title": "新建文件夹...",
        "category": "Cube",
        "icon": "$(new-folder)"
      },
      {
        "command": "cube.downloadFile",
        "title": "下载",
        "category": "Cube",
        "icon": "$(cloud-download)"
      },
      {
        "command": "cube.deleteFile",
        "title": "删除",
        "category": "Cube",
        "icon": "$(trash)"
      },
      {
        "command": "cube.copyFileUrl",
        "title": "复制文件地址",
        "category": "Cube",
        "icon": "$(link)"
      },
      {
        "command": "cube.openFile",
        "title": "打开文件",
        "category": "Cube"
      },
      {
        "command": "cube.previewImage",
        "title": "预览图片",
        "category": "Cube",
        "icon": "$(eye)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cube.refresh",
          "when": "view == cubeExplorer",
          "group": "navigation"
        },
        {
          "command": "cube.uploadFile",
          "when": "view == cubeExplorer",
          "group": "navigation"
        },
        {
          "command": "cube.newFolder",
          "when": "view == cubeExplorer",
          "group": "navigation"
        },
        {
          "command": "cube.toggleConvertWebp",
          "when": "view == cubeExplorer && cube.convertWebp",
          "group": "1_toggles",
          "title": "$(check) WebP: ON",
          "icon": "$(check)"
        },
        {
          "command": "cube.toggleConvertWebp",
          "when": "view == cubeExplorer && !cube.convertWebp",
          "group": "1_toggles",
          "title": "$(circle-large-outline) WebP: OFF",
          "icon": "$(circle-large-outline)"
        },
        {
          "command": "cube.toggleUseUuid",
          "when": "view == cubeExplorer && cube.useUuid",
          "group": "1_toggles",
          "title": "$(check) UUID: ON",
          "icon": "$(check)"
        },
        {
          "command": "cube.toggleUseUuid",
          "when": "view == cubeExplorer && !cube.useUuid",
          "group": "1_toggles",
          "title": "$(circle-large-outline) UUID: OFF",
          "icon": "$(circle-large-outline)"
        },
        {
          "command": "cube.setApiKey",
          "when": "view == cubeExplorer",
          "group": "1_settings"
        },
        {
          "command": "cube.setApiUrl",
          "when": "view == cubeExplorer",
          "group": "1_settings"
        }
      ],
      "view/item/context": [
        {
          "command": "cube.uploadFile",
          "when": "view == cubeExplorer && viewItem =~ /^(bucket|folder)$/",
          "group": "1_modification"
        },
        {
          "command": "cube.newFolder",
          "when": "view == cubeExplorer && viewItem =~ /^(bucket|folder)$/",
          "group": "1_modification"
        },
        {
          "command": "cube.openFile",
          "when": "view == cubeExplorer && viewItem =~ /^(file|image)$/",
          "group": "inline"
        },
        {
          "command": "cube.previewImage",
          "when": "view == cubeExplorer && viewItem == image",
          "group": "inline"
        },
        {
          "command": "cube.downloadFile",
          "when": "view == cubeExplorer && viewItem =~ /^(file|image)$/",
          "group": "2_action"
        },
        {
          "command": "cube.copyFileUrl",
          "when": "view == cubeExplorer && viewItem =~ /^(file|image)$/",
          "group": "2_action"
        },
        {
          "command": "cube.deleteFile",
          "when": "view == cubeExplorer && viewItem =~ /^(file|image)$/",
          "group": "3_delete"
        }
      ]
    }
  },
  "scripts": {
    "test": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/extensionTests.js",
    "pretest": "pnpm run compile-web",
    "vscode:prepublish": "pnpm run package-web",
    "compile-web": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "watch-web": "npm-run-all -p watch-web:*",
    "watch-web:esbuild": "node esbuild.js --watch",
    "watch-web:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package-web": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "run-in-browser": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. ."
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/assert": "^1.5.11",
    "eslint": "^10.5.0",
    "typescript-eslint": "^8.61.1",
    "mocha": "^11.7.6",
    "typescript": "^6.0.3",
    "@vscode/test-web": "^0.0.81",
    "esbuild": "^0.28.1",
    "glob": "^13.0.6",
    "npm-run-all": "^4.1.5",
    "@esbuild-plugins/node-globals-polyfill": "^0.2.3",
    "assert": "^2.1.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
